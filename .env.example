# Geração de imagem por IA (botão "Gerar imagem" na etapa de imagem).
# Sem a chave, o botão aparece mas o servidor responde "não configurada".
GEMINI_API_KEY=
# Opcional: modelo de imagem do Gemini (confirme o nome vigente na documentação).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Login e croquis salvos (ver README). Nunca commite valores reais.
# Conexão do Postgres (a integração Neon da Vercel cria esta variável sozinha).
DATABASE_URL=
# Segredo da sessão (>= 32 caracteres): openssl rand -base64 48
SESSAO_SEGREDO=
# Segredo do cron de limpeza (a Vercel o envia como Bearer).
CRON_SECRET=
# Só para scripts/preparar-banco.ts: conta admin inicial.
ADMIN_USUARIO=
ADMIN_SENHA=
